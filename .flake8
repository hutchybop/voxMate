[flake8]
max-line-length = 88
extend-ignore = E203, W503, E402
exclude = 
    .git,
    __pycache__,
    .venv,
    build,
    dist,
    *.egg-info,
    test_runs,
    reports,
    gaffer,
    .DS_Store,
    .env,
    *.pyc,
    *.pyo,
    *.pyd,
    push.sh
    run_voxMate_web_app.sh
    stop_voxMate.sh
    run_voxMate.sh
    .voxenv
    logs